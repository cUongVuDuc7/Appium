<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="OnLive Tv Android">
    <parameter name="platform" value="android device"></parameter>
    <listeners>
        <listener class-name="myListener.MyListener"/>
        <listener class-name="myListener.SuiteListener"/>
    </listeners>
    <test name="Login Test">
        <classes><class name="runners.LoginRunner"></class></classes>
    </test>
    <test name="ForgotPassword Test">
        <classes><class name="runners.ForgotPasswordRunner"></class></classes>
    </test>
    <test name="Profile Test">
        <classes><class name="runners.ProfileRunner"></class></classes>
    </test>
    <test name="MatchSchedule Test">
        <classes><class name="runners.MatchScheduleRunner"></class></classes>
    </test>
    <test name="Home Test">
        <classes><class name="runners.HomeRunner"></class></classes>
    </test>
</suite>
